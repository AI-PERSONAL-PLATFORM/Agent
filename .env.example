AGENTS_PORT=8000
AGENTS_HEALTHCHECK_URL=http://127.0.0.1:8000/health
# Browser origins allowed to call the API (JSON list or comma-separated).
CORS_ORIGINS=http://localhost:3000,tauri://localhost
# Model provider: opencode or ollama.
MODEL_PROVIDER=opencode
# Empty values use the defaults in agents/src/app/core/config.py.
AGENT_MODEL=
# Per-run limits on model requests and total tokens.
AGENT_REQUEST_LIMIT=
AGENT_TOTAL_TOKENS_LIMIT=
# Get an OpenCode Go API key from the OpenCode Console; keep it server-side.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# Used when MODEL_PROVIDER=ollama; set AGENT_MODEL to a pulled model such as llama3.2.
# This value is for Docker; use http://127.0.0.1:11434/v1 when running natively with `mise dev`.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Optional Logfire project write token; empty keeps cloud export disabled.
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=agents
LOGFIRE_ENVIRONMENT=development
LOGFIRE_INCLUDE_CONTENT=false

# Export this value when running the explicit live API test.
AGENT_API_URL=http://127.0.0.1:8000
